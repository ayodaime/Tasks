# SQLite by default (file lives next to this project). For platforms with an
# ephemeral filesystem (e.g. Vercel) switch prisma/schema.prisma's datasource
# to "postgresql" and point this at a hosted Postgres instance (Neon, Supabase, Render, etc).
DATABASE_URL="file:./dev.db"

# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional: restrict self-registration to your company's email domain(s).
# Comma-separated, no @ sign. Leave blank to allow any email to register.
ALLOWED_EMAIL_DOMAINS="yourcompany.com"

# Optional: where uploaded task attachments are stored. Defaults to
# public/uploads (fine for local dev / a VPS). On a host with an ephemeral
# app checkout (e.g. Render), point this at your mounted persistent disk,
# e.g. "/var/data/uploads".
UPLOAD_DIR=""

# Optional: browser push notifications (someone gets pushed an alert when
# they're assigned a task, even if the app isn't open). Leave all three blank
# to skip push — in-app notifications still work either way. Generate a pair
# with `npx web-push generate-vapid-keys` and use the SAME pair in both vars
# below (VAPID_PUBLIC_KEY is used server-side to sign pushes; the NEXT_PUBLIC_
# one is the same value baked into the client bundle at build time, so it
# must never be the private key). VAPID_SUBJECT should be a mailto: address
# or https: URL identifying who's sending the pushes.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourcompany.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
