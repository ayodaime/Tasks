// Prisma schema for the company task tracker.
// SQLite by default for easy self-hosting; switch provider to "postgresql"
// and update DATABASE_URL if deploying to a platform with an ephemeral filesystem.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: "OFFICER" | "SUPERVISOR" | "MANAGER" | "ADMIN"
// department: "ADMINISTRATION" | "CUSTOMER_SERVICE" | "DIGITAL_MARKETING" | "SEO" | "PR" | "HR" | null
// (nullable so existing accounts from before this field existed aren't broken; an admin assigns one via Manage Staff)
// subteams: only meaningful when department is "DIGITAL_MARKETING" — the specific
// sub-team(s) (Design Team, Online Branding, Offline Branding, Social Media) this
// person is on. A Digital Marketing person can be on more than one; everyone else's
// scoping unit is just their single department.
// hidden: excluded from every non-admin's view of the staff directory (assignee/
// manager pickers, task filters) — admins still see hidden accounts everywhere,
// including each other. Self-toggleable in Manage Staff, no lockout risk.
// hideAsManager: a finer-grained version of the same idea, scoped to just the
// "manager in charge" picker — lets someone stay pickable as an assignee while
// staying out of everyone's manager dropdown (e.g. an owner/admin who does work
// but shouldn't be named the manager overseeing a task). Has no effect when
// `hidden` is already true, since that already excludes them from everything.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("OFFICER")
  department    String?
  hidden        Boolean  @default(false)
  hideAsManager Boolean  @default(false)
  createdAt     DateTime @default(now())

  subteams          UserSubteam[]
  tasksCreated      Task[]             @relation("CreatedBy")
  tasksAssigned     Task[]             @relation("AssignedTo")
  tasksManaged      Task[]             @relation("ManagedBy")
  comments          Comment[]
  attachments       Attachment[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  dailyNotes        DailyNote[]
}

// team: "DESIGN_TEAM" | "ONLINE_BRANDING" | "OFFLINE_BRANDING" | "SOCIAL_MEDIA_TEAM"
model UserSubteam {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   String

  @@unique([userId, team])
}

// A free-form line someone writes themselves about what they did that day —
// not tied to a task. Shows up in their Daily Activity feed alongside
// completed tasks and task comments, for things that don't warrant a task of
// their own (a meeting, an ad-hoc request, general admin work).
model DailyNote {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
}

// status: "TODO" | "IN_PROGRESS" | "BLOCKED" | "DONE"
// priority: "LOW" | "MEDIUM" | "HIGH" | "URGENT"
// A task is scoped by one or more "groups" (TaskGroup rows) instead of a single
// department: each group is either a non-Digital-Marketing department code or one
// of the 4 Digital Marketing sub-team codes (never "DIGITAL_MARKETING" itself —
// same leaf-level units used for User.department/subteams). Zero groups means
// unclassified (admin-only, same as a null department used to mean).
model Task {
  id          String    @id @default(cuid())
  title       String
  description String
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  assigneeId String?
  assignee   User?   @relation("AssignedTo", fields: [assigneeId], references: [id])

  managerId String?
  manager   User?   @relation("ManagedBy", fields: [managerId], references: [id])

  groups        TaskGroup[]
  comments      Comment[]
  attachments   Attachment[]
  notifications Notification[]

  @@index([status])
  @@index([assigneeId])
  @@index([managerId])
}

model TaskGroup {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  group  String

  @@unique([taskId, group])
  @@index([group])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  filepath  String
  size      Int
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
}

// type: "ASSIGNED" | "MANAGER_ASSIGNED" — which role the user was just given on
// the task. One row per "tagging" event; this is the in-app notification feed,
// independent of whether a push message was also sent (push is best-effort and
// has no durable record of its own).
model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// One row per browser/device a user has granted push permission on (a person
// can be subscribed on more than one). `endpoint` is the push service URL the
// browser gave us; p256dh/auth are the keys needed to encrypt messages to it.
// A subscription is deleted once its endpoint starts rejecting pushes (the
// browser unsubscribed it, e.g. the user cleared site data or uninstalled).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
